{
  "name": "black-sentinel-nexus-free",
  "version": "1.0.0-free",
  "description": "BlackSentinel Nexus Free - New Generation SIEM (Free Edition)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @bsn/api dev\" \"pnpm --filter @bsn/web dev\"",
    "build": "node scripts/build.js",
    "build:turbo": "turbo build",
    "start": "node scripts/start.js",
    "stop": "node scripts/stop.js",
    "reset-db": "node scripts/reset-db.js",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "setup": "node scripts/build.js && node scripts/start.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "turbo": "^2.10.13"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
