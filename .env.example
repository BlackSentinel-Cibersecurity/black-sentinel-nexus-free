# ============================================
# BlackSentinel Nexus - Environment Variables
# ============================================
# Copy this file to .env and configure for your environment

# === API SERVER ===
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# === DATABASE ===
# SQLite (default - no config needed)
DATABASE_TYPE=sqlite
DATABASE_PATH=./black_sentinel.db

# PostgreSQL (uncomment for production)
# DATABASE_TYPE=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=blacksentinel
# DATABASE_USER=bsn_user
# DATABASE_PASSWORD=your_secure_password_here

# === JWT AUTH ===
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=24h

# === AI / OPENAI (Optional) ===
# AI_API_KEY=sk-your-openai-api-key-here

# === EMAIL NOTIFICATIONS (Optional) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=BlackSentinel <noreply@blacksentinel.io>

# === SLACK NOTIFICATIONS (Optional) ===
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# === GENERIC WEBHOOK (Optional) ===
# WEBHOOK_URL=https://your-webhook-endpoint.com/security-events

# === REDIS (Optional - for caching/queues) ===
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# === FRONTEND ===
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
